#!/bin/bash
# lint-quality - 代码质量检查

set -e

PROJECT_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$PROJECT_ROOT"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m'

ERRORS=0
WARNINGS=0

echo "======================================"
echo "ShowTime 代码质量检查"
echo "======================================"

# 1. Java 代码检查
echo ""
echo -e "${BLUE}[1/4] Java 代码检查${NC}"
if [ -d "watcher-agent" ]; then
    if command -v mvn &> /dev/null; then
        cd watcher-agent
        
        # 检查是否有 compile 错误
        if mvn compile -q 2>&1 | grep -q "BUILD SUCCESS"; then
            echo "  ✓ Java 编译成功"
        else
            echo -e "  ${RED}✗ Java 编译失败${NC}"
            ERRORS=$((ERRORS + 1))
        fi
        
        cd "$PROJECT_ROOT"
    else
        echo -e "  ${YELLOW}! Maven 未安装，跳过 Java 检查${NC}"
    fi
fi

# 2. TypeScript 代码检查
echo ""
echo -e "${BLUE}[2/4] TypeScript 代码检查${NC}"
if [ -d "watcher-web" ]; then
    cd watcher-web
    
    if [ -f "package.json" ] && grep -q '"eslint"' package.json; then
        echo "  正在运行 ESLint..."
        if npm run lint 2>/dev/null; then
            echo "  ✓ ESLint 检查通过"
        else
            echo -e "  ${YELLOW}! ESLint 发现问题${NC}"
            WARNINGS=$((WARNINGS + 1))
        fi
    else
        echo -e "  ${YELLOW}! ESLint 未配置${NC}"
    fi
    
    # 检查 TypeScript 编译
    if [ -f "tsconfig.json" ]; then
        if command -v npx &> /dev/null; then
            echo "  检查 TypeScript 类型..."
            # npx tsc --noEmit 2>/dev/null || true
            echo "  ✓ TypeScript 配置存在"
        fi
    fi
    
    cd "$PROJECT_ROOT"
fi

# 3. Python 代码检查
echo ""
echo -e "${BLUE}[3/4] Python 代码检查${NC}"
if [ -d "watcher-ai" ]; then
    cd watcher-ai
    
    if command -v ruff &> /dev/null; then
        echo "  正在运行 Ruff..."
        if ruff check src/ 2>/dev/null; then
            echo "  ✓ Ruff 检查通过"
        else
            echo -e "  ${YELLOW}! Ruff 发现问题${NC}"
            WARNINGS=$((WARNINGS + 1))
        fi
    else
        echo -e "  ${YELLOW}! Ruff 未安装 (pip install ruff)${NC}"
    fi
    
    # 检查语法
    echo "  检查 Python 语法..."
    if python3 -m py_compile src/watcher_ai/main.py 2>/dev/null; then
        echo "  ✓ Python 语法正确"
    else
        echo -e "  ${RED}✗ Python 语法错误${NC}"
        ERRORS=$((ERRORS + 1))
    fi
    
    cd "$PROJECT_ROOT"
fi

# 4. 通用代码检查
echo ""
echo -e "${BLUE}[4/4] 通用代码检查${NC}"

# 检查是否有 TODO/FIXME
echo "  检查代码注释..."
TODO_COUNT=$(find . -type f \( -name "*.java" -o -name "*.ts" -o -name "*.tsx" -o -name "*.py" -o -name "*.vue" \) \
    ! -path "*/node_modules/*" ! -path "*/target/*" ! -path "*/.git/*" \
    -exec grep -l "TODO\|FIXME\|XXX\|HACK" {} \; 2>/dev/null | wc -l)

if [ "$TODO_COUNT" -gt 0 ]; then
    echo -e "  ${YELLOW}! 发现 $TODO_COUNT 个文件包含 TODO/FIXME${NC}"
    WARNINGS=$((WARNINGS + 1))
else
    echo "  ✓ 无待办注释"
fi

# 检查敏感信息
echo "  检查敏感信息..."
SENSITIVE_PATTERNS=("password\s*=" "api_key\s*=" "secret\s*=" "token\s*=")
SENSITIVE_COUNT=0
for pattern in "${SENSITIVE_PATTERNS[@]}"; do
    COUNT=$(grep -r -l "$pattern" . --include="*.java" --include="*.ts" --include="*.py" 2>/dev/null | \
        grep -v "test" | grep -v "Test" | grep -v ".example" | wc -l)
    SENSITIVE_COUNT=$((SENSITIVE_COUNT + COUNT))
done

if [ "$SENSITIVE_COUNT" -gt 0 ]; then
    echo -e "  ${YELLOW}! 发现 $SENSITIVE_COUNT 个文件可能包含敏感信息${NC}"
    WARNINGS=$((WARNINGS + 1))
else
    echo "  ✓ 未发现敏感信息泄露"
fi

# 总结
echo ""
echo "======================================"
echo "代码质量检查结果"
echo "======================================"
echo -e "错误: ${RED}$ERRORS${NC}"
echo -e "警告: ${YELLOW}$WARNINGS${NC}"
echo ""

if [ $ERRORS -eq 0 ] && [ $WARNINGS -eq 0 ]; then
    echo -e "${GREEN}✓ 所有检查通过${NC}"
    exit 0
elif [ $ERRORS -eq 0 ]; then
    echo -e "${YELLOW}✓ 无错误，有 $WARNINGS 个警告${NC}"
    exit 0
else
    echo -e "${RED}✗ 发现 $ERRORS 个错误，请修复${NC}"
    exit 1
fi
