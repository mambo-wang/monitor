#!/bin/bash
# lint-deps - 检查项目依赖完整性

set -e

PROJECT_ROOT="$(cd "$(dirname "$0")/.." && pwd)"
cd "$PROJECT_ROOT"

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
NC='\033[0m'

ERRORS=0

echo "======================================"
echo "ShowTime 依赖完整性检查"
echo "======================================"

# 1. 检查 Java 依赖
echo ""
echo "[1/5] 检查 Java 依赖..."
if [ -f "watcher-agent/pom.xml" ]; then
    if command -v mvn &> /dev/null; then
        echo "  Maven: $(mvn -version 2>/dev/null | head -1)"
        echo "  ✓ Java 项目配置存在"
    else
        echo -e "  ${RED}✗ Maven 未安装${NC}"
        ERRORS=$((ERRORS + 1))
    fi
else
    echo -e "  ${YELLOW}! Java 项目不存在${NC}"
fi

# 2. 检查前端依赖
echo ""
echo "[2/5] 检查前端依赖..."
if [ -f "watcher-web/package.json" ]; then
    if [ -d "watcher-web/node_modules" ]; then
        echo "  ✓ node_modules 已安装"
    else
        echo -e "  ${YELLOW}! node_modules 未安装 (需要运行 npm install)${NC}"
        ERRORS=$((ERRORS + 1))
    fi
    
    # 检查关键依赖
    if grep -q '"vue"' watcher-web/package.json; then
        echo "  ✓ Vue 依赖已配置"
    fi
    if grep -q '"element-plus"' watcher-web/package.json; then
        echo "  ✓ Element Plus 依赖已配置"
    fi
else
    echo -e "  ${YELLOW}! 前端项目不存在${NC}"
fi

# 3. 检查 Python 依赖
echo ""
echo "[3/5] 检查 Python 依赖..."
if [ -f "watcher-ai/requirements.txt" ]; then
    REQUIRED_PACKAGES=("fastapi" "uvicorn" "chromadb" "pydantic")
    
    for pkg in "${REQUIRED_PACKAGES[@]}"; do
        if python3 -c "import $pkg" 2>/dev/null; then
            echo "  ✓ $pkg 已安装"
        else
            echo -e "  ${RED}✗ $pkg 未安装 (pip install $pkg)${NC}"
            ERRORS=$((ERRORS + 1))
        fi
    done
    
    # 检查 conda 环境
    if command -v conda &> /dev/null; then
        if conda env list 2>/dev/null | grep -q "showtime"; then
            echo "  ✓ showtime conda 环境存在"
        else
            echo -e "  ${YELLOW}! showtime conda 环境不存在${NC}"
        fi
    fi
else
    echo -e "  ${YELLOW}! Python 项目不存在${NC}"
fi

# 4. 检查 ChromaDB 数据目录
echo ""
echo "[4/5] 检查数据目录..."
if [ -d "watcher-ai/src/chroma_db" ]; then
    echo "  ✓ ChromaDB 目录存在"
    COLLECTIONS=$(find watcher-ai/src/chroma_db -name "*.sqlite3" 2>/dev/null | wc -l)
    if [ "$COLLECTIONS" -gt 0 ]; then
        echo "  ✓ ChromaDB 数据文件存在"
    fi
else
    echo -e "  ${YELLOW}! ChromaDB 目录不存在 (服务首次启动会自动创建)${NC}"
fi

# 5. 检查外部服务配置
echo ""
echo "[5/5] 检查外部服务配置..."

# Ollama
if curl -s http://localhost:11434/api/version &>/dev/null; then
    echo "  ✓ Ollama 服务运行中"
else
    echo -e "  ${YELLOW}! Ollama 服务未运行 (需要: ollama serve)${NC}"
fi

# MiniMax API Key
if [ -n "$MINIMAX_API_KEY" ]; then
    echo "  ✓ MINIMAX_API_KEY 已配置"
else
    echo -e "  ${YELLOW}! MINIMAX_API_KEY 未配置${NC}"
fi

# 总结
echo ""
echo "======================================"
if [ $ERRORS -eq 0 ]; then
    echo -e "${GREEN}✓ 所有依赖检查通过${NC}"
    exit 0
else
    echo -e "${RED}✗ 发现 $ERRORS 个问题，请修复后再继续${NC}"
    exit 1
fi
